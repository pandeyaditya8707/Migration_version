# ==============================================================================
# Agentic Data Migration Planner & Reconciliation Workbench
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit real credentials, passwords, or production secrets to git.
# ==============================================================================

# Application Runtime
APP_ENV=development
APP_NAME="Agentic Data Migration Workbench"
APP_VERSION=1.0.0
DEBUG=True

# Server Networking
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database Configuration
# Default: Local SQLite database in ACID WAL mode
# Production: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///backend/app/data/target_store.db
SQLITE_WAL_MODE=True

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key

# Ingestion & Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_SAMPLE_RECORDS_LIMIT=100000

# Audit & Logging
LOG_LEVEL=INFO
ENABLE_AUDIT_LEDGER=True
AUDIT_SNAPSHOT_RETENTION_DAYS=30

# ==============================================================================
# Version 2.0: Ollama & Autonomous LLM Planner Configuration
# ==============================================================================
# Ollama Host (Local: http://localhost:11434, Cloud: https://ollama.com/api)
OLLAMA_HOST=https://ollama.com/api
OLLAMA_MODEL=llama3.2

# Ollama API Key (Required for ollama.com cloud inference, optional for local server)
OLLAMA_API_KEY=your_ollama_api_key_here

